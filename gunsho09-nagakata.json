 "poems": [
  {
   "seq": "1",
   "text": "あら玉の年とはきくにいかなれはたゝ同し身のふりは行らん",
   "kana": "",
   "speaker": "〔舊本行書躰〕",
   "page": 124,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "春每に面かはりせぬ霞こそ年たちかへるしるし成けれ",
   "kana": "",
   "speaker": "",
   "page": 124,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "春霞いくへ重ねてへたつらんえそみくまのゝ浦のはまゆふ",
   "kana": "",
   "speaker": "",
   "page": 124,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "もゝつたふ八十の船路の夕霞幾重へたてつあはの島山",
   "kana": "",
   "speaker": "",
   "page": 124,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "よさの海霞わたれるあけほのに沖こく船の行衞しらすも",
   "kana": "",
   "speaker": "",
   "page": 124,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "〓見かた波のせき路やこゝならん霞のうちにふねよはふなり",
   "kana": "",
   "speaker": "",
   "page": 124,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "おきつしほたかしの海の夕霞いつか濵名のはしもみゆ覽",
   "kana": "",
   "speaker": "",
   "page": 124,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "なからへば我世の春の思ひでにかたるはかりの花櫻かな",
   "kana": "",
   "speaker": "",
   "page": 124,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "おほつかな一村見ゆるしら雲やよしのゝたけの春のはつ花",
   "kana": "",
   "speaker": "",
   "page": 124,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "我心いくしほ春にそめつらん花さへにほふあけほのゝ空",
   "kana": "",
   "speaker": "",
   "page": 124,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "ひきつらね〓とちをたてゝ歸る膓浪にしらへの聲あはすなる",
   "kana": "",
   "speaker": "",
   "page": 124,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "たつね行人も道にやまよひけむ霞へたつるあまの川かみ",
   "kana": "",
   "speaker": "按納言集春",
   "page": 125,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "花の香をしるへにやりし鶯のをのか聲にも人さそひける",
   "kana": "",
   "speaker": "",
   "page": 125,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "花の木の枝にこつたふ鶯は聲のみならす見まほしき哉",
   "kana": "",
   "speaker": "",
   "page": 125,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "鶯のこゑまたしふく聞ゆなりすたちのをのゝ春のあけほの",
   "kana": "",
   "speaker": "",
   "page": 125,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "ねくらとはみかきの竹をしめをきて千世をは君にちきる鶯",
   "kana": "",
   "speaker": "",
   "page": 125,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "花は散香はにほひくる梅ゆへにうれしくつらき春の風かな",
   "kana": "",
   "speaker": "",
   "page": 125,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "君ませといひにはやらて梅か香を風の便にまかせてそよる",
   "kana": "",
   "speaker": "",
   "page": 125,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "むめの花さかぬ垣ねも匂ふかなよその木すゑに風や吹らん",
   "kana": "",
   "speaker": "",
   "page": 125,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "見わたせは若菜つむへく成にけりくるすのをのゝ荻の燒原",
   "kana": "",
   "speaker": "",
   "page": 125,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "こらか手はさぬれやしぬる飛火野に雪も若なもつみに社つめ",
   "kana": "",
   "speaker": "",
   "page": 125,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "武藏野のすゝろか中のした蕨またうらわかしむらさきのちり",
   "kana": "",
   "speaker": "",
   "page": 125,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "咲そむる雲井の花はいはねとも空にそ千世の春はしらるゝ",
   "kana": "",
   "speaker": "",
   "page": 125,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "散もうくまつもくるしき櫻花咲初てこそ物もおもはね",
   "kana": "",
   "speaker": "",
   "page": 125,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "花の色はあかしとそ思ふ万代をさなから春になしてみるとも",
   "kana": "",
   "speaker": "",
   "page": 125,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "いさゝらは吉野の山のやま守と花のさかりは人にいはれむ",
   "kana": "",
   "speaker": "",
   "page": 125,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "咲てちる時そくるしき櫻花まちしは物も思はさりけり",
   "kana": "",
   "speaker": "",
   "page": 125,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "28",
   "text": "春風のやゝ吹まゝに高砂のおのへにきゆる花の白雪",
   "kana": "",
   "speaker": "",
   "page": 125,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "29",
   "text": "年へてもわすれやはせん花盛志賀の山こえせしはその日と",
   "kana": "",
   "speaker": "",
   "page": 125,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "30",
   "text": "花ゆへにのりに心そうつりぬるいつもしほまぬ色をみんとて",
   "kana": "",
   "speaker": "",
   "page": 125,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "31",
   "text": "よし野山こすゑに花の散まゝにたえ〓〓になる峯のしら雲",
   "kana": "",
   "speaker": "",
   "page": 125,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "32",
   "text": "春のうちは花にけかるといはるへき庭をも風の朝きよめする",
   "kana": "",
   "speaker": "",
   "page": 125,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "33",
   "text": "さくら咲ひらの山風ふくなへに花のさゝ波よするみつうみ",
   "kana": "",
   "speaker": "",
   "page": 125,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "34",
   "text": "花ゆへにふみならす哉みよしのゝよしのゝ山のいはのかけ道",
   "kana": "",
   "speaker": "",
   "page": 125,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "35",
   "text": "我をまつ故〓人は花さそふ風やあやなくうれしかるらん",
   "kana": "",
   "speaker": "",
   "page": 125,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "36",
   "text": "みなそこに花の錦をうつしもて又あやをるは池のさゝ浪",
   "kana": "",
   "speaker": "",
   "page": 125,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "37",
   "text": "曇りなき池のかゝみのそこきよみうつしとゝめよ花のおも影",
   "kana": "",
   "speaker": "",
   "page": 125,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "38",
   "text": "春雨の糸すちよはみをりいてゝ花のにしきを染るぬれ色",
   "kana": "",
   "speaker": "",
   "page": 125,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "39",
   "text": "庭の面にいまこれはかりつもりなは梢に殘る花やなからん",
   "kana": "",
   "speaker": "",
   "page": 125,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "40",
   "text": "水の面に花のにしきをしきみてゝ波のたゝむにまかせたる哉",
   "kana": "",
   "speaker": "",
   "page": 125,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "41",
   "text": "暮ぬともなを見にゆかん櫻花あすは靑葉に成もこそすれ",
   "kana": "",
   "speaker": "",
   "page": 125,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "42",
   "text": "まだちらぬ花もやあると春霞へたつる山を幾重こゆらん",
   "kana": "",
   "speaker": "",
   "page": 125,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "43",
   "text": "池水のそこにも色のうつらすはたゝ一枝の花をみましを",
   "kana": "",
   "speaker": "",
   "page": 125,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "44",
   "text": "筏士のこなたかなたへこす棹のしつえをさふる柳はらかな",
   "kana": "",
   "speaker": "",
   "page": 125,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "45",
   "text": "もえ出る春はけしきの〓となれは草葉そ駒のこゝろなりける",
   "kana": "",
   "speaker": "",
   "page": 125,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "46",
   "text": "春くれは澤邊のまこもつのくみてなつみし駒も引替へてみゆ",
   "kana": "",
   "speaker": "",
   "page": 125,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "47",
   "text": "春くれは雲にいりぬとみゆる哉澤邊にあるゝつるふちの駒",
   "kana": "",
   "speaker": "",
   "page": 125,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "48",
   "text": "日にそへてみどりそまさる春雨のふるからをのゝ道の芝草",
   "kana": "",
   "speaker": "",
   "page": 125,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "49",
   "text": "くれなゐのやしほの岡のいはつゝしこや山姫のまふりての袖",
   "kana": "",
   "speaker": "",
   "page": 125,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "50",
   "text": "みたやもりせきそわつらふ五月雨にあせこす計みかさ增りて",
   "kana": "",
   "speaker": "",
   "page": 125,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "51",
   "text": "なつの夜は月のみふねにまほあげて天の戶わたる程のなき哉",
   "kana": "",
   "speaker": "",
   "page": 125,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "52",
   "text": "ゆふされば一むらすゝき打なひき鹿こそなかね秋のけしきそ",
   "kana": "",
   "speaker": "",
   "page": 125,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "53",
   "text": "夕されは難波のあしを吹風にこやのわたりそ涼しかりける",
   "kana": "",
   "speaker": "",
   "page": 125,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "54",
   "text": "ゆふされはせき風はやき〓見潟秋とおほゆる波まくらかな",
   "kana": "",
   "speaker": "",
   "page": 125,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "55",
   "text": "岩間もる水のあたりの凉しさにしられて夏の過にけるかな",
   "kana": "",
   "speaker": "",
   "page": 125,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "56",
   "text": "しら波のこすかとそみる卯花のさける垣ねやすゑの松山",
   "kana": "",
   "speaker": "",
   "page": 125,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "57",
   "text": "卯花の枝さしかはすほそ道は雪のした行心ちこそすれ",
   "kana": "",
   "speaker": "",
   "page": 125,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "58",
   "text": "心をそつくしはてぬる郭公ほのゆく宵の村雨のそら",
   "kana": "",
   "speaker": "",
   "page": 125,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "59",
   "text": "時鳥雲井のよその一聲はきかてやみぬといはぬはかりそ",
   "kana": "",
   "speaker": "",
   "page": 125,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "60",
   "text": "郭公かたらひあかす名殘にはまつ〓ひよりも物をこそ思へ",
   "kana": "",
   "speaker": "",
   "page": 125,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "61",
   "text": "たまさかにきなくとならは郭公まつよのかすに聲はきかせよ",
   "kana": "",
   "speaker": "",
   "page": 125,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "62",
   "text": "ほとゝきすよそになくねのいかなれは草の枕に露こほるらん",
   "kana": "",
   "speaker": "",
   "page": 125,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "63",
   "text": "たち花のしたてる枝に郭公かたこひすらし聲もこのはぬ",
   "kana": "",
   "speaker": "",
   "page": 125,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "64",
   "text": "あれにけるたかつのみやの郭公たれもなにはの〓とかたるらん",
   "kana": "",
   "speaker": "",
   "page": 125,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "65",
   "text": "秋たちて〓とそともなくかなしきはおぎの葉そよく夕くれの空",
   "kana": "",
   "speaker": "按納言集夏",
   "page": 125,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "66",
   "text": "たなはたはたゝよふ雲をころもにて月の光やかゝみ成らむ",
   "kana": "",
   "speaker": "",
   "page": 125,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "67",
   "text": "咲そむる小萩か原をみ渡せはまたをりはてぬ錦成けり",
   "kana": "",
   "speaker": "",
   "page": 125,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "68",
   "text": "我宿に野原の荻をうつさはや鹿のしからむいろのおしきに",
   "kana": "",
   "speaker": "",
   "page": 125,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "69",
   "text": "夕されはま萩か下に小鹿ふしたゝゑにかける野邊のけしきそ",
   "kana": "",
   "speaker": "",
   "page": 125,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "70",
   "text": "わきもこか花のすかたの女郞花たまのころもやあきの夕露",
   "kana": "",
   "speaker": "",
   "page": 125,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "71",
   "text": "さらすとてたゝにはすきじ花薄まねかて人のこゝろをもみよ",
   "kana": "",
   "speaker": "",
   "page": 125,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "72",
   "text": "おほかたの秋吹風は身にしむにこはよにしらぬおぎのをと哉",
   "kana": "",
   "speaker": "秋",
   "page": 126,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "73",
   "text": "すかるふすくるすのをのゝ糸薄まそほの色に露やそむ覽",
   "kana": "",
   "speaker": "",
   "page": 126,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "74",
   "text": "夕されは尾花かたよる秋風に見たれもあへぬつゆのしら玉",
   "kana": "",
   "speaker": "",
   "page": 126,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "75",
   "text": "をしかなく山の麓にやとりして心つからそ袖ぬらしつる",
   "kana": "",
   "speaker": "",
   "page": 126,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "76",
   "text": "さをしかの聲そ悲しき露むすふいはたのおのゝ荻のしたふし",
   "kana": "",
   "speaker": "",
   "page": 126,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "77",
   "text": "駒とむるひのくま河の底きよみ月さへ影をうつしつるかな",
   "kana": "",
   "speaker": "",
   "page": 126,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "78",
   "text": "山端に月まち出るよひのまはおほろけならすうれしかりけり",
   "kana": "",
   "speaker": "",
   "page": 126,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "79",
   "text": "あかていらん名殘もいとゝおしめとや傾ふく儘にすめる月影",
   "kana": "",
   "speaker": "",
   "page": 126,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "80",
   "text": "雲はらふたひにひかりそまさりける月をは風のみかく成けり",
   "kana": "",
   "speaker": "",
   "page": 126,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "81",
   "text": "〓瀧の河瀨にさゆる月影は冬よりさきのこほりなりけり",
   "kana": "",
   "speaker": "",
   "page": 126,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "82",
   "text": "入月を誰ためなにのおしむらん心はやまのあなたにそすむ",
   "kana": "",
   "speaker": "",
   "page": 126,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "83",
   "text": "やをかゆく演のまさこをしきかへて玉になしつる秋のよの月",
   "kana": "",
   "speaker": "",
   "page": 126,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "84",
   "text": "むこの海にあまの呼聲聞ゆなり霧のあなたにあひきすらしも",
   "kana": "",
   "speaker": "",
   "page": 126,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "85",
   "text": "神垣や世〓にたえせぬ石〓水月もひさしき影やすむらん",
   "kana": "",
   "speaker": "",
   "page": 126,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "86",
   "text": "かやかれに虫恨みける野邊にしもひとりさぬれは都思ほゆ",
   "kana": "",
   "speaker": "",
   "page": 126,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "87",
   "text": "とまりするみなとに影のやとる夜は月もたひねの心ち社すれ",
   "kana": "",
   "speaker": "",
   "page": 126,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "88",
   "text": "神ますと人はいへともかしは木の杜の木の間は月のみそもる",
   "kana": "",
   "speaker": "",
   "page": 126,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "89",
   "text": "生駒山たかれに月の入まゝにこほりきえ行古やのいけ水",
   "kana": "",
   "speaker": "",
   "page": 126,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "90",
   "text": "さやけさを今宵と人のいひをきし昔もかくや月はすみけむ",
   "kana": "",
   "speaker": "",
   "page": 126,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "91",
   "text": "鈴虫を御狩のたかのをとかとて野邊のきゝすや草かくるらん",
   "kana": "",
   "speaker": "",
   "page": 126,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "92",
   "text": "忘られてたなれの駒もこぬ宿にいかてをとなふくつは虫そも",
   "kana": "",
   "speaker": "",
   "page": 126,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "93",
   "text": "とをつ道行にしせなを戀わひてむなしきねやに衣うつなり",
   "kana": "",
   "speaker": "",
   "page": 126,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "94",
   "text": "ねさめしてきけは物こそかなしけれとをちの里に衣うつこゑ",
   "kana": "",
   "speaker": "",
   "page": 126,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "95",
   "text": "あすか川せゝに浪よりくれなゐやかつちき山の木からしの風",
   "kana": "",
   "speaker": "",
   "page": 126,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "96",
   "text": "妹か袖まきての山をくれなゐに干しほふり出雨や染らん",
   "kana": "",
   "speaker": "",
   "page": 126,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "97",
   "text": "みむろ山神に錦もたむけせし紅葉の色にあける此ころ",
   "kana": "",
   "speaker": "",
   "page": 126,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "98",
   "text": "筏さほにしきをわけてくたすめりにふの川上紅葉散らし",
   "kana": "",
   "speaker": "",
   "page": 126,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "99",
   "text": "時雨ふる音羽の山のあらしゆへ紅葉になれるせきの杉ばら",
   "kana": "",
   "speaker": "",
   "page": 126,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "100",
   "text": "山めくり村雨にして過れはや業の木のはなそめはつすらむ",
   "kana": "",
   "speaker": "",
   "page": 126,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "101",
   "text": "難波かたこや夕霧の立ならんいこまの山のみねのむらきえ",
   "kana": "",
   "speaker": "",
   "page": 126,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "102",
   "text": "杣人は道まよふらしまき向のひはらもみえす霧たち渡る",
   "kana": "",
   "speaker": "",
   "page": 126,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "103",
   "text": "長月のきくのした水汲くれはおいせぬくすり誰かたつねん",
   "kana": "",
   "speaker": "",
   "page": 126,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "104",
   "text": "もみちはを吹もちらさて小倉山峯のあらしの我を待ける",
   "kana": "",
   "speaker": "",
   "page": 126,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "105",
   "text": "吹たひに梢の風はよはりつゝ月はひかりのまさり行かな",
   "kana": "",
   "speaker": "",
   "page": 126,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "106",
   "text": "音もせぬあしの丸やの村時雨くもるのみこそしるし成けれ",
   "kana": "",
   "speaker": "",
   "page": 126,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "107",
   "text": "深山邊のならの葉かしは散つみて上には夜半の時雨をとなふ",
   "kana": "",
   "speaker": "",
   "page": 126,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "108",
   "text": "松風の音かときけはあはち島時雨すくとて笘たつぬなり",
   "kana": "",
   "speaker": "",
   "page": 126,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "109",
   "text": "みやまへのならのはさはく初時雨幾むらすきぬあけかたの空",
   "kana": "",
   "speaker": "",
   "page": 126,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "110",
   "text": "まろねするをしまの崎の筈やかたもくつか上に雪もしきけり",
   "kana": "",
   "speaker": "",
   "page": 126,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "111",
   "text": "みなと風寒く吹らしたつのなくなこの入江につらゝゐにけり",
   "kana": "",
   "speaker": "",
   "page": 126,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "112",
   "text": "都人花のたよりをまたすともかれめる草のいほりをはとへ",
   "kana": "",
   "speaker": "",
   "page": 126,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "113",
   "text": "春ならぬ花とみよとやみよしのゝ玉松か枝にふれる白雪",
   "kana": "",
   "speaker": "",
   "page": 126,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "114",
   "text": "山里に夜半の時雨ときゝつるは紅葉をやとに吹にそ有ける",
   "kana": "",
   "speaker": "",
   "page": 126,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "115",
   "text": "かつらきやくめちの橋のとたえにも紅葉を風のわたしつる哉",
   "kana": "",
   "speaker": "",
   "page": 126,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "116",
   "text": "原の池の汀はつらゝゐにけらし湊をさしてつたふあちむら",
   "kana": "",
   "speaker": "",
   "page": 126,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "117",
   "text": "あられふるゐなのしは山行人のしらたまつゝむまくりての袖",
   "kana": "",
   "speaker": "",
   "page": 126,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "118",
   "text": "竹の葉にそゝや霰の音すなりさらても夢のさむるおりしも",
   "kana": "",
   "speaker": "",
   "page": 126,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "119",
   "text": "夜もすから床のさむしろ下さえて今朝は高根にみ雪つもれり",
   "kana": "",
   "speaker": "",
   "page": 126,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "120",
   "text": "初雪のふるの神杉うつもれてしめゆふ野邊は冬こもりせり",
   "kana": "",
   "speaker": "",
   "page": 126,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "121",
   "text": "宮木ひく柚やま人は跡もなしひはら杉はらゆきふかくして",
   "kana": "",
   "speaker": "",
   "page": 126,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "122",
   "text": "道すからふるとはすれと行こまのつめもかくれぬけさの初雪",
   "kana": "",
   "speaker": "",
   "page": 126,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "123",
   "text": "難波かたみきは日をへてこほるらしうらはの浪もおきに成行",
   "kana": "",
   "speaker": "",
   "page": 126,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "124",
   "text": "冬ふかみおふの浦風さえ〓〓て霜かれにけりいせのはま荻",
   "kana": "",
   "speaker": "",
   "page": 126,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "125",
   "text": "敷島やふるのみやこは跡たえてならしの岡にみゆきつもれり",
   "kana": "",
   "speaker": "",
   "page": 126,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "126",
   "text": "おきつしほさしての磯のはま千鳥風さむからし夜半に友よふ",
   "kana": "",
   "speaker": "",
   "page": 126,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "127",
   "text": "冬の夜は玉のうてなに霜さえて雲井にたつの一聲そする",
   "kana": "",
   "speaker": "",
   "page": 126,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "128",
   "text": "雪のうちに友をたつねし心ちしてあはての浦に歸る舟人",
   "kana": "",
   "speaker": "戀",
   "page": 127,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "129",
   "text": "あけぬとて鳥たになかはけふを又ふる年と社いはんとすらめ",
   "kana": "",
   "speaker": "",
   "page": 127,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "130",
   "text": "白雲の八重たつみねを暮て行年とともにや我もこゆへき",
   "kana": "",
   "speaker": "",
   "page": 127,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "131",
   "text": "庭の面に雪こそふかく成にけれ我身にとしのつもるのみがは",
   "kana": "",
   "speaker": "",
   "page": 127,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "132",
   "text": "おち瀧つはや瀨の川もいはふれてしはしはよとむ涙とも哉",
   "kana": "",
   "speaker": "",
   "page": 127,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "133",
   "text": "うしといひつらしといふもをしなへて心は同し戀にそ有ける",
   "kana": "",
   "speaker": "",
   "page": 127,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "134",
   "text": "つれなきを猶さりともとなくさむる我心こそいのち成けれ",
   "kana": "",
   "speaker": "",
   "page": 127,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "135",
   "text": "ひとすちに君を思そ入にけるこひ路はかへるかたやなからむ",
   "kana": "",
   "speaker": "",
   "page": 127,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "136",
   "text": "袂にはたえぬ涙も戀にのみくちぬる名をはえこそすゝかね",
   "kana": "",
   "speaker": "",
   "page": 127,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "137",
   "text": "戀しなむ同し浮名をいかにしてあふにかへつと人にいはれん",
   "kana": "",
   "speaker": "",
   "page": 127,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "138",
   "text": "きの國やゆらの岬にひろふてふたまさかにたにあふよしも哉",
   "kana": "",
   "speaker": "",
   "page": 127,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "139",
   "text": "しなの路や木曾のみさかの小笹原わけ行袖もかくや露けき",
   "kana": "",
   "speaker": "",
   "page": 127,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "140",
   "text": "さりともとおもふ心になくさめていはて過にしかたそ戀しき",
   "kana": "",
   "speaker": "",
   "page": 127,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "141",
   "text": "誰をかはうらみもすへきうつせ貝心くたくも我からそかし",
   "kana": "",
   "speaker": "",
   "page": 127,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "142",
   "text": "これもみなむくひあるらんさきの世に我ゆへ君も物や思ひし",
   "kana": "",
   "speaker": "",
   "page": 127,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "143",
   "text": "いひずてゝ君か心しつらからはそを恨みてもなくさみなまし",
   "kana": "",
   "speaker": "",
   "page": 127,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "144",
   "text": "かくしつゝあらぬ其よになりぬともみし佛はいかゝわすれん",
   "kana": "",
   "speaker": "",
   "page": 127,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "145",
   "text": "人しれぬ心のうちのかね〓とをむなしくなさぬ行末もがな",
   "kana": "",
   "speaker": "",
   "page": 127,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "146",
   "text": "君かすむ宿の水際にいはのあらは雲と成てもふれんとそ思ふ",
   "kana": "",
   "speaker": "",
   "page": 127,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "147",
   "text": "道のへの草はか露となりてさは君かもすそをぬらしてし哉",
   "kana": "",
   "speaker": "",
   "page": 127,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "148",
   "text": "ありへてはいかゝなるへき我なからつきせぬ戀の果そ床しき",
   "kana": "",
   "speaker": "",
   "page": 127,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "149",
   "text": "しまきふくひゝきのなたの船わたり心まとふも誰によりてそ",
   "kana": "",
   "speaker": "",
   "page": 127,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "150",
   "text": "草をなみうたのやけ野にすむきしのなにゝ隱れて戀を忍はん",
   "kana": "",
   "speaker": "",
   "page": 127,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "151",
   "text": "伊勢の海おふの恨をかさねつゝあふ〓ななしの身をいかにせむ",
   "kana": "",
   "speaker": "",
   "page": 127,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "152",
   "text": "戀をのみすまの汐干に玉もかるあまりにうたて袖なぬらしそ",
   "kana": "",
   "speaker": "",
   "page": 127,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "153",
   "text": "たつればやあひつの山の中に又人にしられぬ道やあるらん",
   "kana": "",
   "speaker": "",
   "page": 127,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "154",
   "text": "あさましや思はさりしを思ひ出とありし其よのならむ物とは",
   "kana": "",
   "speaker": "",
   "page": 127,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "155",
   "text": "身にかへむうき名のみかは永きよも同し戀路に猶やまとはん",
   "kana": "",
   "speaker": "",
   "page": 127,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "156",
   "text": "おほつかな戀はいかなる色なれはいひそむるより深く成ゆく",
   "kana": "",
   "speaker": "",
   "page": 127,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "157",
   "text": "今はとてしはし忘るゝ時しもあれ何なをざりの〓とのはそこは",
   "kana": "",
   "speaker": "",
   "page": 127,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "158",
   "text": "戀わひぬ淵にもいらん今はさはこむよをまつと契りたにをけ",
   "kana": "",
   "speaker": "",
   "page": 127,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "159",
   "text": "我戀はこさしのもちにつく鳥の思ひはなてとえこそはなれね",
   "kana": "",
   "speaker": "",
   "page": 127,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "160",
   "text": "しつかをるみつきの麻の筋よはみくるしき戀のしけきふし哉",
   "kana": "",
   "speaker": "",
   "page": 127,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "161",
   "text": "さゝ蟹の我いか樣にふるまひて君かあたりにかきもつきなん",
   "kana": "",
   "speaker": "",
   "page": 127,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "162",
   "text": "難波かた堀江の芦におひまさるよしなき戀に身をくたく哉",
   "kana": "",
   "speaker": "",
   "page": 127,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "163",
   "text": "あふ坂の山路たつれて入はかり我をゆるさむ關守もかな",
   "kana": "",
   "speaker": "",
   "page": 127,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "164",
   "text": "なかむれはいとゝ物こそかなしけれ暮れ行ほとの空の村雲",
   "kana": "",
   "speaker": "",
   "page": 127,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "165",
   "text": "今は只そらしはてつるはし鷹のいかて雲井のよそにたにみん",
   "kana": "",
   "speaker": "",
   "page": 127,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "166",
   "text": "我戀は海士のもしほの何なれやからしわりなし人しれすのみ",
   "kana": "",
   "speaker": "",
   "page": 127,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "167",
   "text": "結ふへき人もあるらんわか松のおひ行すゑはいかゝたのまん",
   "kana": "",
   "speaker": "",
   "page": 127,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "168",
   "text": "思ひかねしなはやといひし〓との葉も逢みてはまつ悔しかり鳬",
   "kana": "",
   "speaker": "",
   "page": 127,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "169",
   "text": "我戀は小倉の山のきりかくれしかありけりとたれかしるへき",
   "kana": "",
   "speaker": "",
   "page": 127,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "170",
   "text": "色ふかくしたに思はん岩つゝしいはしやいはゝちりも社すれ",
   "kana": "",
   "speaker": "",
   "page": 127,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "171",
   "text": "東路やあふ坂山のゆきすりに見し人しもそつれなかりける",
   "kana": "",
   "speaker": "",
   "page": 127,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "172",
   "text": "包みてもほに出るけふそ賤かゝる秋の山田の否といふなゆめ",
   "kana": "",
   "speaker": "",
   "page": 127,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "173",
   "text": "小篠原わけ行露もある物をあなあやにくの袖の雫や",
   "kana": "",
   "speaker": "",
   "page": 127,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "174",
   "text": "妹か門駒のあしおるはしもかなそなかこちても暫しとまらん",
   "kana": "",
   "speaker": "",
   "page": 127,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "175",
   "text": "思ひわひすさひにもするはひ占もあふてふ事は嬉しかりけり",
   "kana": "",
   "speaker": "",
   "page": 127,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "176",
   "text": "なみた川淵と成てもはては猶あふせにかはるなかれともかな",
   "kana": "",
   "speaker": "",
   "page": 127,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "177",
   "text": "波あらふはま松か枝のたむけ草としふる戀に袖そかはかぬ",
   "kana": "",
   "speaker": "",
   "page": 127,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "178",
   "text": "まちしよに思ひよそへて幾かへり山のはいつる月をみつらん",
   "kana": "",
   "speaker": "",
   "page": 127,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "179",
   "text": "我せこはまつちの山にすまねとも見し俤やひれふりし袖",
   "kana": "",
   "speaker": "",
   "page": 127,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "180",
   "text": "わか戀はたつれ行へきかたそなきうらやましきは三輪の杉村",
   "kana": "",
   "speaker": "",
   "page": 127,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "181",
   "text": "いかこ潟よこの浦はにをく網のめを並へてもあはてやめとや",
   "kana": "",
   "speaker": "",
   "page": 127,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "182",
   "text": "しはかこふ園の瓜生の一列になるとしならはまくりあへかし",
   "kana": "",
   "speaker": "",
   "page": 127,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "183",
   "text": "永き日を夜半のけしきと思ひせは獨やいとゝあかしかねまし",
   "kana": "",
   "speaker": "",
   "page": 127,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "184",
   "text": "夜とゝもにあふせたえせぬ中川もつらゝゐぬれは通ふ物かは",
   "kana": "",
   "speaker": "",
   "page": 127,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "185",
   "text": "神垣や磯邊の松にことゝはむけふをは代〓のためしとやみる",
   "kana": "",
   "speaker": "",
   "page": 127,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "186",
   "text": "あやめふく五月にかゝるあふひ草永き例にひかれもやせん",
   "kana": "",
   "speaker": "",
   "page": 127,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "187",
   "text": "けにやけに千世の例となるへきは五月にかゝるあふひ成けり",
   "kana": "",
   "speaker": "",
   "page": 127,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "188",
   "text": "神風やいすゝ河かみ宮居して幾よろつ代か君をまもらん",
   "kana": "",
   "speaker": "",
   "page": 127,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "189",
   "text": "またもこむ程をまつへき秋たにもわかるゝけふは悲しき物を",
   "kana": "",
   "speaker": "",
   "page": 127,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "190",
   "text": "身にしみておしむとをしれ別にし名殘の秋のかたみと思へは",
   "kana": "",
   "speaker": "",
   "page": 127,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "191",
   "text": "みな人はもゝの木のはとちり〓〓になり行程はいかゝ悲しき",
   "kana": "",
   "speaker": "",
   "page": 127,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "192",
   "text": "諸人の花さく春をよそにみて猶しくるゝはしゐしはの袖",
   "kana": "",
   "speaker": "",
   "page": 127,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "193",
   "text": "世中を思ひしとけはあたし野に風まつほとのかるかやの露",
   "kana": "",
   "speaker": "",
   "page": 127,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "194",
   "text": "よの中はうたのかりはにすむ岸のありとてありと如何賴まん",
   "kana": "",
   "speaker": "",
   "page": 127,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "195",
   "text": "世中はきしのかけ草れをたえてよせくる浪をまつ程そかし",
   "kana": "",
   "speaker": "",
   "page": 127,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "196",
   "text": "いかゝせむ我より和哥の浦人もうき世のあみを出ぬときけは",
   "kana": "",
   "speaker": "雜",
   "page": 128,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "197",
   "text": "うき身には時雨もよその物なれや歎くなけきの色もかはらぬ",
   "kana": "",
   "speaker": "",
   "page": 128,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "198",
   "text": "おなしくは苔の袂にぬきかへていとひばてつと君につけはや",
   "kana": "",
   "speaker": "",
   "page": 128,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "199",
   "text": "思ひしる心のみこそあはれなれ苔の袖にもまよふうき世を",
   "kana": "",
   "speaker": "寂蓮",
   "page": 128,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "200",
   "text": "澤邊にて子をおもふ鶴の鳴聲をあまつ雲井にいかてとをさん",
   "kana": "",
   "speaker": "",
   "page": 128,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "201",
   "text": "塵となる跡とふまてはかたけれと誰もしのはぬ柿の本かは",
   "kana": "",
   "speaker": "",
   "page": 128,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "202",
   "text": "かきつめし〓とはの露のかす〓とにのりの海にはけふや入らん",
   "kana": "",
   "speaker": "",
   "page": 128,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "203",
   "text": "をしなへて同しみのりの雨なれとうるふ草木はものゝ品〓〓",
   "kana": "",
   "speaker": "",
   "page": 128,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "204",
   "text": "おきつ浪たかしまめくり漕過てはるかに成ぬしほつすか浦",
   "kana": "",
   "speaker": "",
   "page": 128,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "205",
   "text": "旅に出てみれは悲しも故〓のみやこの方はかすむ一むら",
   "kana": "",
   "speaker": "",
   "page": 128,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "206",
   "text": "別れつゝ今はこし路の歸る山えそひとかたにおもひさためぬ",
   "kana": "",
   "speaker": "",
   "page": 128,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "207",
   "text": "一夜ぬる草の枕もよゝをへて結ひをきてし契りならすや",
   "kana": "",
   "speaker": "",
   "page": 128,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "208",
   "text": "おもひ出のなきにもあらぬ昔こそ忘れぬ夢のなかき成けれ",
   "kana": "",
   "speaker": "",
   "page": 128,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "209",
   "text": "春の花秋のもみちをみし友のなかはゝ苔のしたにくちぬる",
   "kana": "",
   "speaker": "",
   "page": 128,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "210",
   "text": "さくらゐの里にて春は花をみて秋はかつらの月をなかめん",
   "kana": "",
   "speaker": "",
   "page": 128,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "211",
   "text": "うつすとも筆もをよはしあはちなるゑしまの石にかゝる白波",
   "kana": "",
   "speaker": "",
   "page": 128,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "212",
   "text": "はかなしやむなしき床に明くれてとしのむそちの空に過ゐる",
   "kana": "",
   "speaker": "",
   "page": 128,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "213",
   "text": "中〓〓に散なむのちの爲とてそしほれし花のかほもはちけん",
   "kana": "",
   "speaker": "",
   "page": 128,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "214",
   "text": "かくはかりせきわつらはゝ淚川みやこのかたへ流れいらなん",
   "kana": "",
   "speaker": "",
   "page": 128,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "215",
   "text": "まほろしは玉のうてなにたつねきてむかしの秋の契りをそ聞",
   "kana": "",
   "speaker": "",
   "page": 128,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  }
 ],
 "catalog": {
